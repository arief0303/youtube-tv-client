{
  "name": "youtube-tv-client",
  "version": "1.0.2",
  "description": "Native YouTube TV client with built-in ad blocking",
  "main": "index.js",
  "scripts": {
    "start": "electron .",
    "test:logging": "node --test test/adblock-debug.test.js",
    "blocklist": "node scripts/build-blocklist.js",
    "build": "npm run blocklist && electron-builder",
    "build:linux": "npm run blocklist && electron-builder --linux dir --x64 --publish never"
  },
  "build": {
    "appId": "com.arief0303.youtubetvclient",
    "productName": "YouTubeTV",
    "executableName": "youtube-tv-client",
    "files": ["index.js", "adblock-debug.js", "package.json", "resources/adblock.bin", "img/icon/youtube.png"],
    "win": {
      "target": ["portable"],
      "icon": "img/icon/youtube.ico",
      "artifactName": "${productName}_v${version}_x64_win.${ext}"
    },
    "linux": {
      "target": ["AppImage"],
      "icon": "img/icon/youtube.png",
      "artifactName": "${productName}_v${version}_linux.${ext}",
      "category": "AudioVideo"
    }
  },
  "keywords": [],
  "author": "Haroon01",
  "license": "ISC",
  "dependencies": { "@ghostery/adblocker-electron": "2.20.3" },
  "devDependencies": { "electron": "45.2.2", "electron-builder": "26.18.0" }
}
